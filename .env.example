# Copy to .env — NO VITE_ prefix (keys stay on the server, not in the JS bundle)

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional — only for one-time dev seed via server config
SEED_FIRESTORE=false

# Optional analytics (public measurement ID, served via /.netlify/functions/config)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Hope Assistant — Cloudflare Workers AI (server only, never VITE_)
# Dashboard → Workers AI → Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# VITE_FIREBASE_*  →  FIREBASE_*
# VITE_GA_MEASUREMENT_ID  →  GA_MEASUREMENT_ID
# VITE_SEED_FIRESTORE  →  SEED_FIRESTORE
