# Copy to .env and fill in values from Firebase Console → Project settings → Your apps (Web app)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" once to auto-seed the stories collection in dev (optional)
VITE_SEED_FIRESTORE=false

# Optional analytics
# VITE_GA_MEASUREMENT_ID=

# --- Hope Assistant (disabled on site) ---
# To re-enable later: restore route in App.jsx + nav link, then add on Netlify:
# GEMINI_API_KEY=...  (never VITE_GEMINI_API_KEY)
# See src/pages/HopeAssistant.jsx and netlify/functions/gemini.mjs
